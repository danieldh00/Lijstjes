# Alleen nodig als je NIET als Home Assistant Add-on draait (zie docker-compose.yml
# in de hoofdmap van de repo). Als add-on regelt Supervisor dit automatisch via
# SUPERVISOR_TOKEN en hoef je niets van onderstaande in te vullen.

# Basis-URL van je Home Assistant-instantie, bv. http://homeassistant.local:8123
HA_URL=

# Long-Lived Access Token, aangemaakt via je HA-profiel > Beveiliging.
# Kan ook later eenmalig via de pairing-pagina van de app zelf ingevuld worden --
# dan hoeft dit bestand niet ingevuld te worden.
HA_TOKEN=

PORT=3100
DATA_DIR=./data
